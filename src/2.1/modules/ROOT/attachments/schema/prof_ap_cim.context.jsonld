{
  "@context": {
    "@version": 1.1,
    "id": "@id",
    "type": "@type",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "cim": "https://cim.ucaiug.io/ns#",
    "cims": "https://cim.ucaiug.io/schema-extensions#",
    "nl": "https://cim.ucaiug.io/nl/ns#",
    "prof": "http://www.w3.org/ns/dx/prof/",
    "role": "http://www.w3.org/ns/dx/prof/role/",
    "sh": "http://www.w3.org/ns/shacl#",
    "@vocab": "http://www.w3.org/ns/shacl#",
    "version": {
      "@id": "dcat:version",
      "@type": "xsd:string"
    },
    "versionOf": {
      "@id": "dcat:versionOf",
      "@type": "@id"
    },
    "profileOf": {
      "@id": "prof:profileOf",
      "@type": "@id"
    },
    "imports": {
      "@id": "owl:imports",
      "@type": "xsd:anyURI"
    },
    "classes": {
      "@id": "nl:hasClass",
      "@container": "@id"
    },
    "enumerations": {
      "@id": "nl:hasEnumeration",
      "@container": "@id"
    },
    "sh:path": {
      "@type": "@id"
    },
    "properties": {
      "@id": "sh:property",
      "@container": "@index",
      "@index": "sh:path"
    },
    "datatype": {
      "@id": "sh:datatype",
      "@type": "@id"
    },
    "node": {
      "@id": "sh:node",
      "@type": "@id"
    },
    "closed": {
      "@id": "sh:closed",
      "@type": "xsd:boolean"
    },
    "nodeKind": {
      "@id": "sh:nodeKind",
      "@type": "@id"
    },
    "minCount": {
      "@id": "sh:minCount",
      "@type": "xsd:integer"
    },
    "maxCount": {
      "@id": "sh:maxCount",
      "@type": "xsd:integer"
    },
    "label": {
      "@id": "rdfs:label",
      "@type": "xsd:string"
    },
    "definition": {
      "@id": "skos:definition",
      "@container": "@language"
    },
    "values": {
      "@id": "sh:in",
      "@type": "@id",
      "@container": "@list"
    }
  }
}
