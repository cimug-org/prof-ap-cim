{
  "@context": {
    "sh": "http://www.w3.org/ns/shacl#",
    "adms": "http://www.w3.org/ns/adms#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "dcat": "http://www.w3.org/ns/dcat#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "cim": "https://cim.ucaiug.io/ns#",
    "cims": "https://cim.ucaiug.io/schema-extensions#",
    "prof": "http://www.w3.org/ns/dx/prof/",
    "role": "http://www.w3.org/ns/dx/prof/role/",
    "id": "@id",
    "type": "@type",
    "@vocab": "http://www.w3.org/ns/shacl#",
    "shapes": {
      "@id": "cims:shapes",
      "@container": "@id"
    },
    "property": {
      "@container": "@index",
      "@index": "path"
    },
    "in": {
      "@container": "@list"
    },
    "node": {
      "@type": "@id"
    },
    "nodeKind": {
      "@type": "@id"
    },
    "datatype": {
      "@type": "@id"
    },
    "path": {
      "@type": "@id"
    }
  },
  "id": "https://ucaiug.io/prof-ap-cim/2.1",
  "type": "owl:Ontology",
  "rdfs:label": "PROF-AP-CIM",
  "dcterms:title": "PROF-AP-CIM",
  "dcat:isVersionOf": "https://ucaiug.io/prof-ap-cim",
  "rdfs:seeAlso": "https://www.ucaiug.io/prof-ap-cim/2.1",
  "dcat:conformsTo": "https://www.w3.org/TR/dx-prof/",
  "dcterms:description": "Application profile of \"`The Profiles Vocabulary`\" (PROF) for describing CIM profiles.",
  "dcterms:license": "https://www.apache.org/licenses/LICENSE-2.0.txt",
  "rdfs:comment": "This is pretty much how I would do it.",
  "shapes": {
    "prof:Profile": {
      "type": [
        "sh:NodeShape",
        "rdfs:Class"
      ],
      "rdfs:label": "Profile",
      "dcterms:description": "A specification that constrains, extends, combines, or provides guidance or explanation about the usage of other specifications. This definition includes what are sometimes called \"`application profiles`\", \"`metadata application profiles`\", or \"`metadata profiles`\".\n",
      "property": {
        "dcat:version": {
          "rdfs:label": "version",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "The version indicator (name or identifier) of a resource."
        },
        "dcterms:title": {
          "rdfs:label": "title",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "A name given to the resource."
        },
        "dcat:isVersionOf": {
          "rdfs:label": "isVersionOf",
          "nodeKind": "sh:IRI",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "A related resource of which the described resource is a version, edition, or adaptation."
        },
        "dcat:previousVersion": {
          "rdfs:label": "previousVersion",
          "nodeKind": "sh:IRI",
          "minCount": 0,
          "dcterms:description": "The previous version of a resource in a lineage."
        },
        "dcterms:issued": {
          "rdfs:label": "issued",
          "datatype": "xsd:dateTime",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "Date of formal issuance of the resource."
        },
        "dcterms:conformsTo": {
          "rdfs:label": "conformsTo",
          "nodeKind": "sh:IRI",
          "minCount": 1,
          "dcterms:description": "An established standard to which the described resource conforms."
        },
        "dcterms:source": {
          "rdfs:label": "source",
          "datatype": "xsd:string",
          "minCount": 0,
          "dcterms:description": "A related resource from which the described resource is derived."
        },
        "dcterms:contributor": {
          "rdfs:label": "contributor",
          "nodeKind": "sh:IRI",
          "minCount": 1,
          "dcterms:description": "An entity responsible for making contributions to the resource."
        },
        "dcterms:creator": {
          "rdfs:label": "contributor",
          "nodeKind": "sh:IRI",
          "minCount": 1,
          "dcterms:description": "An entity primarily responsible for making the resource."
        },
        "dcterms:description": {
          "rdfs:label": "description",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "An account of the resource."
        },
        "rdfs:comment": {
          "rdfs:label": "comment",
          "datatype": "xsd:string",
          "minCount": 0,
          "dcterms:description": "A description of the subject resource."
        },
        "rdfs:label": {
          "rdfs:label": "label",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "A human-readable name for the subject."
        },
        "dcterms:language": {
          "rdfs:label": "language",
          "datatype": "xsd:language",
          "minCount": 0,
          "maxCount": 1,
          "dcterms:description": "A language of the resource."
        },
        "dcterms:license": {
          "rdfs:label": "license",
          "nodeKind": "sh:IRI",
          "minCount": 0,
          "maxCount": 1,
          "dcterms:description": "A legal document giving official permission to do something with the resource."
        },
        "dcterms:publisher": {
          "rdfs:label": "publisher",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "An entity responsible for making the resource available."
        },
        "dcterms:rightsHolder": {
          "rdfs:label": "rightsHolder",
          "datatype": "xsd:string",
          "minCount": 0,
          "maxCount": 1,
          "dcterms:description": "A person or organization owning or managing rights over the resource."
        },
        "dcterms:rights": {
          "rdfs:label": "rights",
          "datatype": "xsd:string",
          "minCount": 0,
          "maxCount": 1,
          "dcterms:description": "Information about rights held in and over the resource."
        },
        "prof:hasResource": {
          "rdfs:label": "hasResource",
          "node": "prof:ResourceDescriptor",
          "minCount": 0,
          "dcterms:description": "A resource which describes the nature of an artifact and the role it plays in relation to the profile."
        }
      }
    },
    "prof:ResourceDescriptor": {
      "type": [
        "sh:NodeShape",
        "rdfs:Class"
      ],
      "rdfs:label": "ResourceDescriptor",
      "property": {
        "rdfs:label": {
          "rdfs:label": "label",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "A human-readable name for the subject."
        },
        "dcterms:title": {
          "rdfs:label": "title",
          "datatype": "xsd:string",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "A name given to the resource."
        },
        "dcterms:conformsTo": {
          "rdfs:label": "conformsTo",
          "nodeKind": "sh:IRI",
          "dcterms:description": "An established standard to which the described resource conforms."
        },
        "dcterms:source": {
          "rdfs:label": "source",
          "datatype": "xsd:string",
          "dcterms:description": "A related resource from which the described resource is derived."
        },
        "dcterms:contributor": {
          "rdfs:label": "contributor",
          "nodeKind": "sh:IRI",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "An account of the resource."
        },
        "adms:representationTechnique": {
          "rdfs:label": "representationTechnique",
          "node": "cims:RepresentationTechnique",
          "maxCount": 1,
          "dcterms:description": "More information about the format in which an asset distribution is released. This is different from the file format as, for example, a ZIP file (file format) could contain an XML schema (representation technique)."
        },
        "dcterms:format": {
          "rdfs:label": "format",
          "node": "cims:RepresentationFormat",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "The file format, physical medium, or dimensions of the resource."
        },
        "prof:hasArtifact": {
          "rdfs:label": "hasArtifact",
          "nodeKind": "sh:IRI",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "The URL of a downloadable file with particulars such as its format and role indicated by the resource descriptor."
        },
        "prof:hasRole": {
          "rdfs:label": "hasRole",
          "node": "cims:ResourceDescriptorRole",
          "minCount": 1,
          "maxCount": 1,
          "dcterms:description": "A description of a resource that defines an aspect - a particular part, feature or role - of a profile."
        }
      }
    },
    "cims:RepresentationTechnique": {
      "type": [
        "sh:NodeShape",
        "skos:ConceptScheme"
      ],
      "rdfs:label": "RepresentationTechnique",
      "in": [
        {
          "id": "cims:linkml",
          "dcterms:description": "The LinkML language."
        },
        {
          "id": "cims:rdfs",
          "dcterms:description": "Resource Description Framework Schema language."
        },
        {
          "id": "cims:shacl",
          "dcterms:description": "The Shapes Constraints Language."
        }
      ]
    },
    "cims:RepresentationFormat": {
      "type": [
        "sh:NodeShape",
        "skos:ConceptScheme"
      ],
      "rdfs:label": "RepresentationFormat",
      "in": [
        {
          "id": "cims:yaml",
          "dcterms:description": "Yet Antother Markup Language."
        },
        {
          "id": "cims:turtle",
          "dcterms:description": "Terse RDF Triple Language."
        },
        {
          "id": "cims:pdf",
          "dcterms:description": "Not to be confused with..."
        }
      ]
    },
    "cims:ResourceDescriptorRole": {
      "type": [
        "sh:NodeShape",
        "skos:ConceptScheme"
      ],
      "rdfs:label": "RourceDescriptorRole",
      "in": [
        {
          "id": "role:constraints",
          "dcterms:description": "Descriptions of obligations, limitations or extensions that the profile defines."
        },
        {
          "id": "role:vocabulary",
          "dcterms:description": "Defines terms used in the profile specification."
        },
        {
          "id": "role:specification",
          "dcterms:description": "Defining the profile in human-readable form."
        }
      ]
    }
  }
}
